[Unit]
Description=Run Database Backup to S3 every 15 days at 12 PM IST
Requires=s3-backup.service

[Timer]
# Run every 15 days at 12:00 PM IST (06:30 UTC) on 1st and 15th of each month
OnCalendar=*-*-1,15 06:30:00
# If the system was off during the scheduled time, run immediately after boot
Persistent=true
# Randomize the start time by up to 30 minutes to avoid thundering herd
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target

